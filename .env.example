# Copy to .env and fill in. Without an LLM key the agents fall back to
# deterministic templates and the pipeline still runs end to end.

VC_LLM_PROVIDER=groq            # groq | gemini
GROQ_API_KEY=
VC_GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
VC_GEMINI_MODEL=gemini-2.5-flash

# Scope / tuning
VC_MIN_MODEL_YEAR=2015
VC_MIN_COMPLAINTS_PER_MODEL=150
VC_RECALL_MATCH_THRESHOLD=0.65
# VC_FOCUS_MAKES=FORD,TESLA,KIA   # restrict embedding/clustering for a quick run

# Snowflake target for dbt (VC_DBT_TARGET=snowflake)
VC_DBT_TARGET=dev
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=VROOMCHECK_WH
SNOWFLAKE_DATABASE=VROOMCHECK
